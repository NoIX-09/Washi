SITE_NAME=My Site
SITE_URL=https://example.com
SITE_EMAIL=hi@example.com
SITE_COPYRIGHT=© 2026 NoIX · Powered by Astro
HERO_NAME=昵称
HERO_SUBTITLE=Subtitle
HERO_QUOTE=Your favorite quote here.
PROFILE_NAME=昵称
PROFILE_BIO=个性签名
PROFILE_BILIBILI=https://space.bilibili.com/xxxxx
PROFILE_GITHUB=https://github.com/xxxxx

# 首页「最近动态」卡片：只显示最新的 N 条，其余折成「展开更多」按钮
# 0 = 不折叠，全部显示；留空或不设 → 用 site.config.ts 里的默认值 3
# ACTIVITY_LIMIT=3
STATUS_PLAYING=玩游戏...
STATUS_MUSIC_TITLE=歌曲名 — 歌手
STATUS_MUSIC_URL=https://music.163.com/song?id=xxxxx
# 今日宜忌卡池：逗号分隔（中英文逗号都行），宜忌共用一个池子，每天抽两个不重复的
# 不设这一项 → 用 site.config.ts 里的内置默认卡池；设成空值 → 整块不显示
# STATUS_ALMANAC=便利店买肉包,在图书馆使用桌角
BOT_NAME=BotName
BOT_DESC=低性能Bot，调试中...
MY_FRIEND_NAME=昵称
MY_FRIEND_DESC=站点描述
MY_FRIEND_URL=https://example.com
# 必须是公开可访问的**绝对地址**（换友链时对方会来抓这张图）。
# 站内展示走 astro:assets 的 src/assets/head.jpg，那条路径每次构建都带新哈希，
# 不能对外，所以这里得另给一份长期稳定的。
# 不设也行 —— 默认是 src/pages/head.svg.ts 生成的占位图，一定存在
MY_FRIEND_AVATAR=https://example.com/head.webp

# 是否在构建期排除示例内容（src/content/*/_example.*）
# 示例条目让 clone 下来直接就是一个能跑的演示站，所以默认保留。
# 你自己的站把它排除掉，在这里设 1 即可（构建期生效，示例不会进任何列表和详情页）
# EXCLUDE_EXAMPLES=1
