<canvas id="firefly-canvas" style="display:none"></canvas>

<style>
  #firefly-canvas {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  body.fx-firefly #firefly-canvas {
    display: block !important;
  }
</style>

<script>
import { readThemeColors } from '../scripts/theme-colors';

(function() {
  const canvas = document.getElementById('firefly-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  interface Firefly { x: number; y: number; r: number; vx: number; vy: number; glow: number; speed: number }
  let fireflies: Firefly[] = [];
  let animId = 0;
  let running = false;
  // 颜色来自 --c-fx-firefly-*-rgb，每次启动时重读（见 startFX）
  let colors = readThemeColors();

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  for (let i = 0; i < 25; i++) {
    fireflies.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      r: 2 + Math.random() * 3,
      vx: -.4 + Math.random() * .8,
      vy: -.6 + Math.random() * .4,
      glow: Math.random() * Math.PI * 2,
      speed: .02 + Math.random() * .03,
    });
  }

  function draw() {
    if (!running) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    for (const f of fireflies) {
      f.glow += f.speed;
      const alpha = .25 + Math.sin(f.glow) * .2;

      const grad = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, f.r * 6);
      grad.addColorStop(0, `rgba(${colors.fireflyCore},${alpha})`);
      grad.addColorStop(.3, `rgba(${colors.fireflyGlow},${alpha * .6})`);
      // 尾档必须跟中档同一个 RGB，否则渐变末端会现出一道色阶
      grad.addColorStop(1, `rgba(${colors.fireflyGlow},0)`);
      ctx.beginPath();
      ctx.arc(f.x, f.y, f.r * 6, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.fill();

      ctx.beginPath();
      ctx.arc(f.x, f.y, f.r * .7, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${colors.fireflyDot},${alpha + .15})`;
      ctx.fill();

      f.x += f.vx;
      f.y += f.vy;
      f.vx += (-.02 + Math.random() * .04);
      f.vy += (-.02 + Math.random() * .04);
      f.vx *= .995;
      f.vy *= .995;

      if (Math.abs(f.vx) > .8) f.vx *= .9;
      if (Math.abs(f.vy) > .8) f.vy *= .9;

      if (f.x < -20) f.x = canvas.width + 20;
      if (f.x > canvas.width + 20) f.x = -20;
      if (f.y < -20) f.y = canvas.height + 20;
      if (f.y > canvas.height + 20) f.y = -20;
    }

    animId = requestAnimationFrame(draw);
  }

  function startFX() {
    // 重读颜色，且必须放在守卫之前：切昼夜时 MutationObserver 走的也是这条路径，
    // 已经跑着的时候也要把新颜色换上去
    colors = readThemeColors();
    if (running) return;
    running = true;
    canvas.style.display = 'block';
    draw();
  }
  function stopFX() {
    running = false;
    cancelAnimationFrame(animId);
    canvas.style.display = 'none';
  }

  const observer = new MutationObserver(() => {
    if (document.body.classList.contains('fx-firefly')) {
      startFX();
    } else {
      stopFX();
    }
  });
  observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });

  if (document.body.classList.contains('fx-firefly')) {
    if ('requestIdleCallback' in window) requestIdleCallback(startFX, { timeout: 2500 });
    else startFX();
  }

  // Layout 的偏好脚本可能晚于本模块执行，它初始化完会补派一次 fx-init
  document.body.addEventListener('fx-init', function() {
    if (document.body.classList.contains('fx-firefly')) startFX();
  });
})();
</script>
