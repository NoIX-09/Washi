---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { t, type Locale } from '../i18n/translations';

const locale = (Astro.currentLocale || 'zh-CN') as Locale;
const skills = await getCollection('skills');
---

<section class="card">
  <h3 class="card-title">{t('home.techStack', locale)}</h3>
  <div class="skills">
    {skills.map(s => (
      <span class="skill">
        {s.data.icon && <Icon name={s.data.icon} size="16" />}
        <span>{s.data.name}</span>
      </span>
    ))}
  </div>
</section>

<style>
  .card {
    border-radius: 12px;
    background: var(--c-surface);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card-title {
    margin: 0;
    font-family: 'LXGW WenKai', 'Kaiti SC', 'KaiTi', 'STKaiti', serif;
    font-size: 17px;
    font-weight: 500;
    color: var(--c-heading);
  }
  .skills { display: flex; flex-wrap: wrap; gap: 8px; }
  .skill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    background: rgba(var(--c-accent-rgb), .1);
    font-size: 13px;
    color: var(--c-text-strong);
  }
  .skill :global(svg) { color: var(--c-accent-solid); flex-shrink: 0; }

  @media (max-width: 600px) {
    .card { padding: 16px; }
  }
</style>
