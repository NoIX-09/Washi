---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { t, LOCALES, type Locale } from '../../i18n/translations';

export function getStaticPaths() {
  return LOCALES.map(l => ({ params: { locale: l } }));
}

const locale = (Astro.currentLocale || 'zh-CN') as Locale;
// getCollection 按 id 字母序返回，这里改用 frontmatter 的 order 排；
// order 相同时再按 id 兜底，保证顺序稳定
const works = (await getCollection('works')).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id)
);
---

<Layout title="Works">
  <div class="page">
    <h1 class="page-title">{t('works.title', locale)}</h1>
    <hr class="pencil-line wide" />
    <div class="works-grid">
      {works.length > 0 ? (
        works.map((w) => (
          <a class="work-card" href={`/${locale}/works/${w.id}`}>
            <div class="work-icon">
              <Icon name={w.data.icon} size="24" />
            </div>
            <div class="work-info">
              <h3>{w.data.name}</h3>
              <p>{w.data.desc}</p>
            </div>
          </a>
        ))
      ) : (
        <div class="empty-hint">
          <Icon name="ph:palette-duotone" size="40" />
          <p>{t('works.emptyHint', locale)}</p>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .page {
    flex: 1;
    width: 100%;
    max-width: 880px;
    padding: 40px 24px 0;
    box-sizing: border-box;
  }
  .page-title {
    font-family: 'LXGW WenKai', 'Kaiti SC', 'KaiTi', 'STKaiti', serif;
    font-size: 28px;
    font-weight: 500;
    color: var(--c-heading);
    margin: 0 0 28px;
  }
  .works-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .work-card {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
    border-radius: 12px;
    background: var(--c-surface);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    text-decoration: none;
    transition: transform .2s, background .2s;
  }
  .work-card:hover { transform: translateY(-2px); background: var(--c-surface-strong); }
  .work-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: rgba(var(--c-accent-rgb), .1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .work-icon :global(svg) { color: var(--c-accent); }
  .work-info { min-width: 0; }
  .work-info h3 { margin: 0; font-family: 'LXGW WenKai', 'Kaiti SC', 'KaiTi', 'STKaiti', serif; font-size: 16px; font-weight: 500; color: var(--c-heading); }
  .work-info p { margin: 6px 0 0; font-size: 13px; color: var(--c-text); line-height: 1.6; }
  .empty-hint {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 60px 0;
    color: var(--c-muted-dim);
  }
  .empty-hint p { margin: 0; font-family: 'LXGW WenKai', 'Kaiti SC', 'KaiTi', 'STKaiti', serif; font-size: 15px; }

  @media (max-width: 600px) {
    .page { padding: 32px 16px 0; }
    .page-title { font-size: 22px; margin: 0 0 20px; }
    .works-grid { grid-template-columns: 1fr; }
    .work-card { padding: 16px; gap: 14px; }
    .work-icon { width: 40px; height: 40px; border-radius: 8px; }
    .work-icon :global(svg) { width: 20px; height: 20px; }
    .work-info h3 { font-size: 15px; }
  }
</style>
