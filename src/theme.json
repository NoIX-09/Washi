{
  "_note": "全站配色的唯一真值源：改这一个文件就能换掉整个站点，不用动任何组件。每个 token 生成两个 CSS 变量：--c-<名字> 是完整颜色，--c-<名字>-rgb 是 \"139, 94, 60\" 形式的三元组 —— 后者用来在样式里拼任意透明度，写成 rgba(var(--c-accent-rgb), .08)。全站十几处不同透明度的强调色因此只认 accent 一个源，改一次全跟着变。值的写法：\"#rrggbb\" / \"rgb(...)\" / \"rgba(...)\" / \"transparent\" / 整条渐变；只写一个字符串 = 明暗共用；\"@别的token\" = 跟随那个 token。值写错会在构建期报错并指名是哪个 token，不会静默失效。",

  "heading": { "light": "#4a3728", "dark": "#f0e0d0", "note": "标题、强调文字" },
  "text": { "light": "#8b7355", "dark": "#d4bfa8", "note": "正文" },
  "text-strong": { "light": "#4a3728", "dark": "#e8d5c4", "note": "需要比正文更实一档的文字（状态卡的值、宜忌条目、代码前景）" },
  "prose": { "light": "#4a3728", "dark": "#d4bfa8", "note": "长文正文（Markdown 渲染出的那部分）。比 text 更实一档，与卡片描述刻意不同" },
  "accent": { "light": "#8b5e3c", "dark": "#c4a574", "note": "交互强调色：链接、图标、URL。全站所有半透明描边/底色都由它的 rgb 三元组派生" },
  "accent-solid": { "light": "@accent", "dark": "#d4bfa8", "note": "实心的强调色块：时间轴圆点、头像与舞台的边框、技术栈图标。浅色下跟随 accent" },
  "accent-hover": { "light": "#6b4530", "dark": "#e8c88a", "note": "正文链接与按钮的悬停色" },
  "muted": { "light": "#b8a088", "dark": "#b8a088", "note": "次要文字：卡片描述、页脚、空状态提示。明暗同值，这是原设计的做法" },
  "muted-dim": { "light": "@muted", "dark": "#8b6f5a", "note": "比 muted 更暗一档：占位符、时间戳、代码注释。暗色下才真正变暗" },
  "muted-faint": { "light": "#ccc", "dark": "#6b5040", "note": "最淡的一档：搜索初始态里那行补充说明。比 muted-dim 还要退后一步" },
  "label": { "light": "#a8927c", "dark": "#9c8069", "note": "表单与信息卡的标签" },
  "nav": { "light": "#555", "dark": "#d4bfa8", "note": "导航链接与图标按钮的常态颜色（纯灰，想更贴暖色调可以调成 #6b5a4a 之类）" },
  "nav-hover": { "light": "#7c3aed", "dark": "#e8c88a", "note": "导航链接与图标按钮的悬停前景" },
  "nav-hover-bg": { "light": "#f3f0ff", "dark": "rgba(200,160,120,.15)", "note": "导航链接与图标按钮的悬停底色" },
  "gold": { "light": "#c4a574", "dark": "#c4a574", "note": "暖金装饰色：引用的左边线、标题装饰。明暗同值" },
  "btn-face": { "light": "linear-gradient(rgba(255,255,255,.78), rgba(255,255,255,.45))", "dark": "linear-gradient(rgba(200,160,120,.14), rgba(200,160,120,.05))", "note": "小按钮的渐变面（机器人卡上的切换按钮）。整条渐变放在这里，因为它不是单个颜色" },
  "btn-face-hover": { "light": "linear-gradient(rgba(255,255,255,.95), rgba(255,255,255,.7))", "dark": "linear-gradient(rgba(200,160,120,.22), rgba(200,160,120,.1))", "note": "上面那颗按钮的悬停态" },
  "stage-face": { "light": "radial-gradient(circle at 50% 38%, rgba(255,255,255,.62), rgba(255,255,255,.26) 62%, rgba(139,94,60,.06))", "dark": "radial-gradient(circle at 50% 38%, rgba(200,160,120,.12), rgba(200,160,120,.04) 62%, rgba(0,0,0,.14))", "note": "Live2D 展示台的纸感底：亮部偏上，模拟台上打光。整条渐变放这里，因为它不是单个颜色" },
  "stage-shadow": { "light": "rgba(139,94,60,.1)", "dark": "rgba(0,0,0,.22)", "note": "展示台的投影。浅色跟着强调色走，暗色换成中性黑" },

  "page": { "light": "#faf3e6", "dark": "#2a1f1a", "note": "页面底色（压在宣纸纹样之下）" },
  "scrim": { "light": "transparent", "dark": "rgba(42,31,26,.5)", "note": "暗色下压在纸纹上的遮罩层，浅色下不需要故为 transparent" },
  "surface": { "light": "rgba(255,255,255,.5)", "dark": "rgba(80,60,48,.6)", "note": "卡片底色" },
  "surface-strong": { "light": "rgba(255,255,255,.7)", "dark": "rgba(90,70,55,.75)", "note": "卡片悬停 / 需要更实的卡片" },
  "surface-raised": { "light": "rgba(255,255,255,.7)", "dark": "rgba(65,48,38,.8)", "note": "顶栏这类浮在最上层的面" },
  "overlay": { "light": "rgba(255,248,240,.97)", "dark": "rgba(42,31,26,.97)", "note": "全屏加载动画的覆盖层" },
  "overlay-soft": { "light": "rgba(250,243,230,.75)", "dark": "rgba(42,31,26,.8)", "note": "半透明遮罩（回到顶部按钮的底等）" },
  "field": { "light": "rgba(0,0,0,.04)", "dark": "rgba(255,255,255,.06)", "note": "顶栏搜索框常态" },
  "field-focus": { "light": "rgba(0,0,0,.07)", "dark": "rgba(255,255,255,.1)", "note": "顶栏搜索框聚焦" },
  "field-sunken": { "light": "rgba(255,255,255,.5)", "dark": "rgba(0,0,0,.15)", "note": "卡片内输入框常态" },
  "field-sunken-focus": { "light": "rgba(255,255,255,.8)", "dark": "rgba(0,0,0,.22)", "note": "卡片内输入框聚焦" },
  "glass": { "light": "rgba(255,255,255,.6)", "dark": "rgba(80,60,48,.6)", "note": "浮在正文之上的玻璃片（回到顶部按钮）。比卡片实一档，因为它下面压着的是正文而不是页面底色" },
  "glass-hover": { "light": "rgba(255,255,255,.85)", "dark": "rgba(90,70,55,.75)", "note": "上面那片玻璃的悬停态" },
  "shadow": { "light": "rgba(0,0,0,.06)", "dark": "rgba(0,0,0,.22)", "note": "投影（顶栏、卡片悬停等）" },
  "divider": { "light": "rgba(139,94,60,.15)", "dark": "rgba(200,180,160,.15)", "note": "分隔线。浅色跟着强调色走，暗色换成中性暖灰" },

  "status-idle": { "light": "#c9bba8", "dark": "#c9bba8", "note": "看板娘待机状态的小圆点" },
  "status-online": { "light": "#4caf50", "dark": "#4caf50", "note": "在线状态的圆点（绿）" },
  "status-online-fg": { "light": "#6f7d4a", "dark": "#a8b98a", "note": "在线状态的文字（橄榄绿）" },
  "almanac-yi": { "light": "#6f7d4a", "dark": "#6f7d4a", "note": "今日宜忌「宜」的徽章底" },
  "almanac-ji": { "light": "#a0522d", "dark": "#a0522d", "note": "今日宜忌「忌」的徽章底" },
  "almanac-fg": { "light": "#fff", "dark": "#fff", "note": "宜忌徽章上的文字" },

  "code-text": { "light": "#4a3728", "dark": "#e8d5c4", "note": "代码块前景" },
  "code-bg": { "light": "rgba(139,94,60,.06)", "dark": "rgba(200,160,120,.08)", "note": "代码块底" },
  "code-comment": { "light": "#a08b72", "dark": "#8b6f5a", "note": "注释" },
  "code-keyword": { "light": "#8b5e3c", "dark": "#d4a574", "note": "关键字" },
  "code-string": { "light": "#6f7d4a", "dark": "#a8b98a", "note": "字符串" },
  "code-constant": { "light": "#a0522d", "dark": "#d89a6a", "note": "常量" },
  "code-function": { "light": "#9c6b3a", "dark": "#e0b07a", "note": "函数名" },
  "code-parameter": { "light": "#7a5c3a", "dark": "#c4a574", "note": "参数" },
  "code-punctuation": { "light": "#8b7355", "dark": "#b8a088", "note": "标点" },
  "code-link": { "light": "#8b5e3c", "dark": "#c4a574", "note": "链接" },

  "fx-rain": { "light": "#beaf9b", "dark": "#beaf9b", "note": "雨滴涟漪。粒子在 Canvas 里画，只能读三元组" },
  "fx-firefly-glow": { "light": "#f0c864", "dark": "#f0c864", "note": "萤火虫光晕的中段与尾段" },
  "fx-firefly-core": { "light": "#ffdc8c", "dark": "#ffdc8c", "note": "萤火虫光晕的中心" },
  "fx-firefly-dot": { "light": "#fff0b4", "dark": "#fff0b4", "note": "萤火虫最中心的高亮点" },
  "fx-sakura": { "light": "#f5bebe", "dark": "#f5bebe", "note": "樱花瓣" },

  "favicon": { "light": "#000000", "dark": "#000000", "note": "站点图标的前景色。favicon 不随昼夜切换，两模式用同一个值" }
